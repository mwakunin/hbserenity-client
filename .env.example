# Where the hbserenity-api process is reachable from THIS server (not the
# browser). Requests are proxied through next.config.ts, so the browser only
# ever sees this app's own origin and no CORS is involved.
API_ORIGIN=http://localhost:9999

# The ImageKit endpoint property photos are served from. Must match
# IMAGEKIT_URL_ENDPOINT on the API, or next/image refuses to optimise them.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/hbserenity
